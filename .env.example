# ====== Secret (WAJIB di-set di Vercel, jangan commit) ======
# Token bot BARU dari BotFather (hasil revoke)
TELEGRAM_BOT_TOKEN=

# Chat ID Telegram admin (tujuan pesan). 2010496733 = chat pribadimu
TELEGRAM_CHAT_ID=2010496733

# Kunci rahasia untuk update link/stok via API (generate: openssl rand -hex 32)
ADMIN_SECRET=

# Secret untuk verifikasi webhook Telegram (generate: openssl rand -hex 16)
WEBHOOK_SECRET=

# ====== Supabase ======
# Project URL: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://xxxx.supabase.co

# Service role key (RAHASIA — hanya untuk server, JANGAN di frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ====== Opsional ======
# Link Canva default saat tabel settings masih kosong
CANVA_DEFAULT_LINK=
